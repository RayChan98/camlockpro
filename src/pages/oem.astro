---
// OEM & Custom Camlock Couplings to Drawing or Sample — slug 沿用旧站
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
---
<BaseLayout
  title="OEM &amp; Custom Camlock Couplings to Drawing or Sample"
  description="Send a drawing or sample and we supply the camlock coupling or fitting in the material, type and size you specify — prototype, production and testing on one line."
>
  <PageHero
    title="OEM &amp; Custom"
    subtitle="Send a drawing or sample and we supply the coupling in the material, type and size you specify — prototype, production and testing on one line."
    breadcrumb={{ label: 'Home', href: '/' }, { label: 'OEM & Custom' }}
  />
  <section class="cp-section">
    <div class="kv-container">
      <article class="cp-prose">
        <h2>OEM &amp; Custom</h2>
        <p>Send a drawing or sample and we supply the camlock to your specification — body material (aluminum, stainless, brass or polypropylene), type letter, size, thread standard and gasket compound. Tooling, prototype and production on one line, with test certificates on every batch.</p>
        <h3>What we can customise</h3>
        <p>Body material and finish (anodized aluminum, 304/316 stainless, nickel-plated brass, PP), type letter and size (A-F, DC, DP, 1/2&quot;-6&quot;), thread standard (NPT, BSPT), gasket compound (EPDM, NBR, Viton, PTFE), branding and packaging.</p>
        <h3>From drawing to production</h3>
        <p>Drawing or sample review — material and construction proposal with figures — prototype — approval — production. OEM, ODM and private label all supported.</p>
        <p>For a specific duty — fluid, pressure, temperature and connection size — send us the operating conditions and we will come back with options and figures.</p>
        <h2>Next step</h2>
        <p>Send your drawing, sample or duty conditions, or browse the coupling ranges first.</p>
      </article>
      <div class="cp-cta">
        <a href="/contact/" class="kv-btn kv-btn--primary kv-btn--lg kv-btn--block-mobile">Request a Quote</a>
        <a href="/products/" class="kv-btn kv-btn--outline kv-btn--lg kv-btn--block-mobile">Browse Coupling Ranges</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cp-section { padding: 4rem 0; }
  .cp-prose { max-width: 52rem; }
  .cp-prose h2 { margin-top: 2.5rem; }
  .cp-prose h3 { margin-top: 1.75rem; }
  .cp-prose p { color: var(--color-muted); line-height: 1.7; margin-bottom: 1.25rem; }
  .cp-cta { display: flex; flex-wrap: wrap; gap: 0.875rem; margin-top: 2.5rem; }
</style>
