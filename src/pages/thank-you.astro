---
// 提交成功页 — slug 沿用旧站 /thank-you/
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Enquiry Sent — CamlockPro"
  description="Your enquiry has been sent. We will come back with hose options and figures."
>
  <section class="cp-thanks">
    <div class="kv-container cp-thanks__inner">
      <h1>Enquiry sent.</h1>
      <p>Thanks — your duty conditions are with us. We will come back with hose options and figures within one business day.</p>
      <div class="cp-thanks__cta">
        <a href="/products/" class="kv-btn kv-btn--primary kv-btn--lg">Browse Hose Ranges</a>
        <a href="/guides/" class="kv-btn kv-btn--outline kv-btn--lg">Read the Selection Guides</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cp-thanks { padding: 6rem 0; text-align: center; }
  .cp-thanks__inner { max-width: 40rem; }
  .cp-thanks h1 { margin-bottom: 1rem; }
  .cp-thanks p { color: var(--color-muted); font-size: 1.0625rem; line-height: 1.7; }
  .cp-thanks__cta { display: flex; flex-wrap: wrap; gap: 0.875rem; justify-content: center; margin-top: 2rem; }
</style>
