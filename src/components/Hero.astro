---
// Hero — 首页首屏(官方最佳实践: 组件化 + Props 驱动 + scoped 样式 + 移动优先)
// 结构: 工业蓝渐变背景 → 左文(badge/H1/lead/双CTA/数据栏) + 右3D喷嘴视觉(桌面显/移动隐)
import Icon from './ui/Icon.astro';

interface Props {
  eyebrow?: string;
  titleHtml?: string;
  lead?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  stats?: { value: string; label: string }[];
}
const { eyebrow, titleHtml = '', lead = '', primaryCta, secondaryCta, stats = [] } = Astro.props;
---
<section class="cp-hero">
  <div class="kv-container cp-hero__inner">
    <div class="cp-hero__content">
      {eyebrow && (
        <p class="cp-hero__badge">
          <Icon name="check" size={15} class="cp-hero__badge-icon" />
          <span>{eyebrow}</span>
        </p>
      )}
      <h1 class="cp-hero__title" set:html={titleHtml} />
      {lead && <p class="cp-hero__lead">{lead}</p>}
      {(primaryCta || secondaryCta) && (
        <div class="cp-hero__cta">
          {primaryCta && (
            <a href={primaryCta.href} class="kv-btn kv-btn--primary kv-btn--lg kv-btn--block-mobile">
              <span>{primaryCta.label}</span>
              <Icon name="arrowRight" size={18} />
            </a>
          )}
          {secondaryCta && (
            <a href={secondaryCta.href} class="kv-btn kv-btn--secondary kv-btn--lg kv-btn--block-mobile">
              <span>{secondaryCta.label}</span>
              <Icon name="arrowRight" size={18} />
            </a>
          )}
        </div>
      )}
      {stats.length > 0 && (
        <div class="cp-hero__stats">
          {stats.map((s) => (
            <span class="cp-hero__stat">
              <span class="cp-hero__stat-value">{s.value}</span>
              <span class="cp-hero__stat-label">{s.label}</span>
            </span>
          ))}
        </div>
      )}
    </div>

    <div class="cp-hero__visual">
      <div class="cp-hero__card">
        <div class="cp-hero__grid"></div>
        <div class="cp-hero__photos">
          <img src="/images/products/camlockpro-aluminum-camlock-coupling-01.webp" alt="CamlockPro aluminum type D camlock coupler with female threaded inlet" width="350" height="285" loading="eager" />
          <img src="/images/products/camlockpro-stainless-camlock-coupling-02.webp" alt="CamlockPro 316 stainless steel type D camlock coupler with female threaded inlet" width="350" height="285" loading="eager" />
          <img src="/images/products/camlockpro-polypropylene-camlock-coupling-03.webp" alt="CamlockPro polypropylene type D camlock coupler for chemical transfer" width="350" height="285" loading="lazy" />
        </div>
        <div class="cp-hero__statusbar">
          <span>ISO 9001 · OEM to Drawing</span>
          <span class="cp-hero__status-right">±0.01 mm</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cp-hero {
    background: linear-gradient(120deg, var(--color-base-900) 0%, #0b5d8f 55%, #1565a0 100%);
    color: #fff;
    padding: 4rem 0;
  }
  .cp-hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .cp-hero__badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.375rem 0.75rem; border-radius: 9999px;
    border: 1px solid rgba(255,255,255,0.18);
    background: rgba(255,255,255,0.07);
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.05em;
    text-transform: uppercase; color: rgba(255,255,255,0.9);
    margin: 0 0 1.25rem;
  }
  .cp-hero__badge-icon { color: var(--color-brand-primary); }

  .cp-hero__title {
    font-size: clamp(1.875rem, 4vw, 2.625rem);
    line-height: 1.15; font-weight: 800; letter-spacing: -0.02em;
    color: #fff; margin: 0 0 1.25rem;
  }
  .cp-hero__title :global(.cp-accent) { color: rgba(255,255,255,0.75); }

  .cp-hero__lead {
    font-size: 1.125rem; line-height: 1.65;
    color: rgba(255,255,255,0.85);
    max-width: 36rem; margin: 0 0 2rem;
  }

  .cp-hero__cta {
    display: flex; flex-wrap: wrap; gap: 0.875rem;
  }

  .cp-hero__stats {
    display: flex; flex-wrap: wrap; gap: 1.5rem 2rem;
    margin-top: 2.5rem; padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.18);
  }
  .cp-hero__stat { display: inline-flex; flex-direction: column; gap: 0.125rem; }
  .cp-hero__stat-value { font-size: 1.375rem; font-weight: 800; color: var(--color-brand-primary); }
  .cp-hero__stat-label { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: rgba(255,255,255,0.75); }

  /* 右视觉块: 移动隐, 桌面显 */
  .cp-hero__visual { display: none; }
  @media (min-width: 1024px) {
    .cp-hero { padding: 5.5rem 0; }
    .cp-hero__inner { grid-template-columns: 7fr 5fr; gap: 3rem; }
    .cp-hero__visual { display: block; }
  }

  .cp-hero__card {
    position: relative; border-radius: 1rem; overflow: hidden;
    border: 1px solid rgba(255,255,255,0.12);
    aspect-ratio: 4 / 3;
    background: radial-gradient(circle at 50% 40%, rgba(21,101,160,0.6), rgba(7,49,77,0.9) 70%);
  }
  .cp-hero__grid {
    position: absolute; inset: 0; opacity: 0.12;
    background-image: linear-gradient(rgba(255,255,255,0.25) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.25) 1px, transparent 1px);
    background-size: 28px 28px;
  }
  .cp-hero__photos {
    position: absolute; inset: 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: 0.875rem;
    padding: 1.25rem 1.25rem 2.75rem;
    align-content: center;
  }
  .cp-hero__photos img {
    width: 100%; height: auto; border-radius: 0.5rem; background: #fff;
    object-fit: cover; aspect-ratio: 4 / 3;
    filter: drop-shadow(0 12px 20px rgba(0,0,0,0.35));
  }
  .cp-hero__photos img:first-child { grid-column: 1 / 3; max-height: 46%; justify-self: center; width: 62%; }
  .cp-hero__statusbar {
    position: absolute; bottom: 0; left: 0; right: 0;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.625rem 1.25rem;
    background: rgba(7,49,77,0.75); backdrop-filter: blur(4px);
    border-top: 1px solid rgba(255,255,255,0.1);
    font-size: 0.75rem; color: rgba(255,255,255,0.8);
  }
  .cp-hero__status-right { color: var(--color-brand-primary); font-weight: 700; }
</style>
