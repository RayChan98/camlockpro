---
// Icon — 统一 SVG 图标(官方组件模式: Props 驱动, 零客户端 JS)
interface Props {
  name: keyof typeof ICONS;
  class?: string;
  size?: number;
  strokeWidth?: number;
  ariaHidden?: boolean;
}
const { name, class: className = '', size = 24, strokeWidth = 2, ariaHidden = true } = Astro.props;

const ICONS = {
  check: '<path d="M9 12l2 2 4-4" /><path d="M21 12c0 5-3.5 7.5-9 7.5S3 17 3 12a9 9 0 0 1 18 0Z" />',
  arrowRight: '<path d="M5 12h14M13 6l6 6-6 6" />',
  arrowUp: '<path d="M12 19V5M6 11l6-6 6 6" />',
  chevronDown: '<path d="M6 9l6 6 6-6" />',
  menu: '<path d="M4 6h16M4 12h16M4 18h16" />',
  close: '<path d="M6 6l12 12M18 6L6 18" />',
  phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z" />',
  mail: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2Z" /><path d="m22 6-10 7L2 6" />',
  whatsapp: '<path d="M21 11.5a8.5 8.5 0 0 1-12.3 7.6L3 21l1.9-5.7A8.5 8.5 0 1 1 21 11.5Z" /><path d="M9 9.5c.5 2 2 3.5 4 4l1.5-1.5 2 1v1.5c0 .8-.7 1.5-1.5 1.5C10.9 16 8 13.1 8 9.5c0-.8.7-1.5 1.5-1.5H11l1 2L10.5 12" />',
} as const;

const pathData = ICONS[name];
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={ariaHidden}
  set:html={pathData}
/>
