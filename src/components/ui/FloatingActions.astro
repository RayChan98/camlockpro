---
// FloatingActions — 右下角悬浮(WhatsApp/电话/回顶)(官方最佳实践: scoped 样式 + inline onclick)
import Icon from './Icon.astro';
import { site } from '../../data/site';
---
<div class="cp-fab">
  <a href={`https://wa.me/${site.waNumber}?text=Hi%20CamlockPro%2C%20I%27d%20like%20to%20inquire%20about%20your%20camlock%20couplings.`} target="_blank" rel="noopener" class="cp-fab__btn cp-fab__btn--whatsapp" aria-label="Chat on WhatsApp">
    <Icon name="whatsapp" size={22} />
  </a>
  <a href={site.telHref} class="cp-fab__btn cp-fab__btn--phone" aria-label="Call us">
    <Icon name="phone" size={20} />
  </a>
  <button class="cp-fab__btn cp-fab__btn--top" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="Back to top">
    <Icon name="arrowUp" size={20} />
  </button>
</div>

<style>
  .cp-fab {
    position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 150;
    display: flex; flex-direction: column; gap: 0.625rem;
  }
  .cp-fab__btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.75rem; height: 2.75rem; border-radius: 9999px;
    border: 0; cursor: pointer; color: #fff;
    box-shadow: 0 8px 20px rgba(15,23,42,0.25);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .cp-fab__btn:hover { transform: translateY(-2px); text-decoration: none; }
  .cp-fab__btn--whatsapp { background: #25d366; }
  .cp-fab__btn--phone { background: var(--color-brand); }
  .cp-fab__btn--top { background: var(--color-base-800); }
</style>
